<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{tw:app.title}" Width="1200" Height="800" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Tw.Bg}"
        FontFamily="{DynamicResource Tw.TextFont}" FontSize="13" Foreground="{DynamicResource Tw.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <!--TW:RESOURCES-->
    </Window.Resources>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{DynamicResource Tw.Surface}" BorderBrush="{DynamicResource Tw.Border}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Tw.Accent}">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource Tw.IconFont}" FontSize="16" Foreground="{DynamicResource Tw.AccentText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Tweaker" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="OsText" FontSize="11" Foreground="{DynamicResource Tw.Muted}"/>
                    </StackPanel>
                </StackPanel>

                <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource Tw.TextBox}" Tag="{tw:ui.search}"
                         MaxWidth="420" Margin="24,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="PresetBox" Style="{StaticResource Tw.ComboBox}" Width="210" ToolTip="{tw:ui.preset.tooltip}"/>
                    <Button x:Name="ApplyButton" Style="{StaticResource Tw.AccentButton}" Margin="8,0,0,0" ToolTip="{tw:ui.apply.tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Tw.IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ApplyText" Text="{tw:ui.apply}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DiscardButton" Style="{StaticResource Tw.Button}" Margin="6,0,0,0" Content="{tw:ui.discard}" ToolTip="{tw:ui.discard.tooltip}"/>
                    <Border Width="1" Height="22" Background="{DynamicResource Tw.Border}" Margin="10,0,4,0"/>
                    <Button x:Name="RestorePointButton" Style="{StaticResource Tw.IconButton}" Content="&#xE7B8;" ToolTip="{tw:ui.restorePoint}"/>
                    <Button x:Name="BackupsButton" Style="{StaticResource Tw.IconButton}" Content="&#xE7A7;" ToolTip="{tw:ui.backups}"/>
                    <Button x:Name="ThemeButton" Style="{StaticResource Tw.IconButton}" Content="&#xE793;" ToolTip="{tw:ui.theme}"/>
                    <Button x:Name="LangButton" Style="{StaticResource Tw.IconButton}" FontFamily="{DynamicResource Tw.TextFont}" FontSize="12" FontWeight="SemiBold"
                            Content="{tw:ui.lang.switch}" ToolTip="{tw:ui.lang.tooltip}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Read-only / warning banner -->
        <Border x:Name="Banner" Grid.Row="1" Background="{DynamicResource Tw.ModerateBg}" Padding="18,8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Tw.IconFont}" Foreground="{DynamicResource Tw.Moderate}" VerticalAlignment="Center"/>
                <TextBlock x:Name="BannerText" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource Tw.Surface}" BorderBrush="{DynamicResource Tw.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Margin="20,10,20,14" FontSize="11" Foreground="{DynamicResource Tw.Muted}"/>
                    <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" Margin="10,12,10,0"
                             ItemContainerStyle="{StaticResource Tw.NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Tw.IconFont}" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="2" CornerRadius="8" Padding="6,0" Background="{DynamicResource Tw.AccentSoft}"
                                            Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding PendingCount}" FontSize="11" Foreground="{DynamicResource Tw.Text}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource Tw.Muted}" VerticalAlignment="Center"
                                               Visibility="{Binding ShowCount, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="32,22,32,6">
                    <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageSubtitle" Margin="0,4,0,0" Foreground="{DynamicResource Tw.SubText}" TextWrapping="Wrap"/>
                </StackPanel>

                <Grid x:Name="FilterBar" Grid.Row="1" Margin="32,8,32,10">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="RiskFilter" Style="{StaticResource Tw.ComboBox}" Width="190"/>
                        <CheckBox x:Name="OnlyChanged" Style="{StaticResource Tw.Check}" Margin="16,0,0,0" Content="{tw:ui.onlyChanged}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="HideUnsupported" Style="{StaticResource Tw.Check}" Margin="16,0,0,0" Content="{tw:ui.hideUnsupported}" VerticalAlignment="Center" IsChecked="True"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="SelectAllButton" Style="{StaticResource Tw.Button}" Padding="10,5" Content="{tw:ui.selectAll}"/>
                        <TextBlock x:Name="CountText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Tw.Muted}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <!-- Tweak cards -->
                    <ScrollViewer x:Name="TweaksPage" VerticalScrollBarVisibility="Auto" Padding="32,0,24,20">
                        <StackPanel>
                            <Border x:Name="DnsPanel" Style="{StaticResource Tw.CardStyle}" Visibility="Collapsed" Margin="0,0,0,14"/>
                            <ItemsControl x:Name="TweakList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Tw.CardStyle}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                                                ToolTipService.InitialShowDelay="700" ToolTipService.ShowDuration="30000">
                                            <Border.ToolTip>
                                                <ToolTip>
                                                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" MaxWidth="440" FontFamily="{DynamicResource Tw.TextFont}"/>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,18,0">
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                        <Border Style="{StaticResource Tw.RiskBadge}">
                                                            <TextBlock Text="{Binding RiskText}" Style="{StaticResource Tw.RiskText}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Tw.Badge}" Visibility="{Binding ShowState, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{DynamicResource Tw.SubText}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Tw.Badge}" Visibility="{Binding ShowUnverified, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding UnverifiedText}" FontSize="11" Foreground="{DynamicResource Tw.Moderate}"/>
                                                        </Border>
                                                        <TextBlock Text="&#xE777;" FontFamily="{StaticResource Tw.IconFont}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Tw.Muted}" ToolTip="{Binding RebootText}"
                                                                   Visibility="{Binding ShowReboot, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding PendingText}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Tw.Accent}" Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Description}" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Tw.SubText}" LineHeight="19"/>
                                                    <TextBlock Text="{Binding Warning}" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Tw.Advanced}"
                                                               Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Style="{StaticResource Tw.Toggle}" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanToggle}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="EmptyText" Text="{tw:ui.empty}" Foreground="{DynamicResource Tw.Muted}" Margin="2,20" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pages built in code (stage 5) -->
                    <ScrollViewer x:Name="ToolPage" VerticalScrollBarVisibility="Auto" Padding="32,0,24,20" Visibility="Collapsed">
                        <StackPanel x:Name="ToolPageContent"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource Tw.Surface}" BorderBrush="{DynamicResource Tw.Border}" BorderThickness="0,1,0,0">
            <Grid>
                <ProgressBar x:Name="Progress" Style="{StaticResource Tw.Progress}" VerticalAlignment="Top" Height="3" Minimum="0" Maximum="100" Value="0" Visibility="Hidden"/>
                <DockPanel Margin="16,7">
                    <Button x:Name="LogToggle" DockPanel.Dock="Right" Style="{StaticResource Tw.Button}" Padding="10,3" FontSize="12" Content="{tw:ui.log}"/>
                    <TextBlock x:Name="StatusIcon" Text="&#xE930;" FontFamily="{StaticResource Tw.IconFont}" Foreground="{DynamicResource Tw.Safe}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource Tw.SubText}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Grid>
        </Border>

        <Border x:Name="LogPanel" Grid.Row="4" Height="180" Visibility="Collapsed" Background="{DynamicResource Tw.Input}"
                BorderBrush="{DynamicResource Tw.Border}" BorderThickness="0,1,0,0">
            <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Tw.SubText}"
                     FontFamily="{DynamicResource Tw.MonoFont}" FontSize="12" Padding="14,8" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Modal dialog -->
        <Grid x:Name="Overlay" Grid.RowSpan="5" Background="{DynamicResource Tw.Overlay}" Visibility="Collapsed">
            <Border Background="{DynamicResource Tw.Surface}" BorderBrush="{DynamicResource Tw.Border}" BorderThickness="1" CornerRadius="12"
                    MaxWidth="660" MinWidth="440" Margin="40" Padding="26,22" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.35"/>
                </Border.Effect>
                <DockPanel>
                    <TextBlock x:Name="DialogTitle" DockPanel.Dock="Top" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14" TextWrapping="Wrap"/>
                    <StackPanel x:Name="DialogButtons" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
                        <StackPanel x:Name="DialogBody"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
