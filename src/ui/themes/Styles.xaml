<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Tw.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Tw.TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Tw.MonoFont">Cascadia Mono, Consolas</FontFamily>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- Buttons -->
    <Style x:Key="Tw.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Tw.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Tw.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Tw.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Hover" Background="{DynamicResource Tw.Hover}" CornerRadius="5" Margin="-14,-7" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Tw.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Tw.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tw.AccentButton" TargetType="Button" BasedOn="{StaticResource Tw.Button}">
        <Setter Property="Background" Value="{DynamicResource Tw.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Tw.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Tw.AccentText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Tw.DangerButton" TargetType="Button" BasedOn="{StaticResource Tw.Button}">
        <Setter Property="Foreground" Value="{DynamicResource Tw.Advanced}"/>
    </Style>

    <Style x:Key="Tw.IconButton" TargetType="Button" BasedOn="{StaticResource Tw.Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="FontFamily" Value="{StaticResource Tw.IconFont}"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <!-- Toggle switch (CheckBox) -->
    <Style x:Key="Tw.Toggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" Width="42" Height="22" CornerRadius="11" Background="{DynamicResource Tw.Track}"
                                BorderBrush="{DynamicResource Tw.TrackBorder}" BorderThickness="1" SnapsToDevicePixels="True"/>
                        <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="{DynamicResource Tw.Thumb}" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,5,0"/>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Tw.Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Tw.Accent}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Tw.AccentText}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Width" Value="14"/>
                            <Setter TargetName="Thumb" Property="Height" Value="14"/>
                            
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Tw.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain checkbox -->
    <Style x:Key="Tw.Check" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Tw.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource Tw.TrackBorder}" Background="{DynamicResource Tw.Input}" VerticalAlignment="Center">
                            <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource Tw.IconFont}" FontSize="11"
                                       Foreground="{DynamicResource Tw.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Tw.Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Tw.Accent}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text input with placeholder in Tag -->
    <Style x:Key="Tw.TextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Tw.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Tw.Input}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Tw.Border}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Tw.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Tw.Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="32,7,10,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <Grid>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Tw.IconFont}" FontSize="13" Margin="11,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Tw.Muted}"/>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="33,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Tw.Muted}" IsHitTestVisible="False" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Padding="0" VerticalAlignment="Center" Focusable="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Tw.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style x:Key="Tw.ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{DynamicResource Tw.Card}" BorderBrush="{DynamicResource Tw.Border}" BorderThickness="1" CornerRadius="6">
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Tw.IconFont}" FontSize="10" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Tw.SubText}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tw.CardHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tw.ComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Tw.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource Tw.ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Tw.Card}" BorderBrush="{DynamicResource Tw.Border}" BorderThickness="1" CornerRadius="8"
                                    Margin="0,4,0,0" Padding="4" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="360">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource Tw.Text}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Padding="10,7" CornerRadius="5" Background="Transparent">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tw.Hover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tw.AccentSoft}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation list -->
    <Style x:Key="Tw.NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Tw.SubText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,8" Margin="0,1">
                        <Grid>
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Tw.Accent}"
                                    HorizontalAlignment="Left" Margin="-10,0,0,0" Visibility="Collapsed"/>
                            <ContentPresenter/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tw.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Tw.Hover}"/>
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource Tw.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Risk / state badges -->
    <Style x:Key="Tw.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="7,1"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource Tw.Hover}"/>
    </Style>

    <Style x:Key="Tw.RiskBadge" TargetType="Border" BasedOn="{StaticResource Tw.Badge}">
        <Setter Property="Background" Value="{DynamicResource Tw.SafeBg}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Risk}" Value="moderate">
                <Setter Property="Background" Value="{DynamicResource Tw.ModerateBg}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Risk}" Value="advanced">
                <Setter Property="Background" Value="{DynamicResource Tw.AdvancedBg}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Tw.RiskText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Tw.Safe}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Risk}" Value="moderate">
                <Setter Property="Foreground" Value="{DynamicResource Tw.Moderate}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Risk}" Value="advanced">
                <Setter Property="Foreground" Value="{DynamicResource Tw.Advanced}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Card -->
    <Style x:Key="Tw.CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Tw.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Tw.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="18,14"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Tw.CardHover}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsPending}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Tw.Accent}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Slim scrollbars -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{DynamicResource Tw.ScrollThumb}" CornerRadius="3" Margin="3,2"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Tw.Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{DynamicResource Tw.Border}" CornerRadius="2"/>
                        <Border x:Name="PART_Indicator" Background="{DynamicResource Tw.Accent}" CornerRadius="2" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Tw.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource Tw.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Tw.Border}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MaxWidth" Value="460"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tw.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Tw.SubText}"/>
        <Setter Property="Margin" Value="2,14,0,8"/>
    </Style>
</ResourceDictionary>
