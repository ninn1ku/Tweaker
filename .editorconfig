root = true

[*]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# Windows PowerShell 5.1 reads BOM-less scripts as ANSI: keep the BOM.
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf

[*.xaml]
end_of_line = crlf

[*.{json,yml,yaml}]
indent_size = 2
end_of_line = lf

[*.md]
end_of_line = lf
trim_trailing_whitespace = false
